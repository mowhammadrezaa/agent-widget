{
  "name": "agent-widget",
  "version": "1.0.0",
  "description": "Floating Mac desktop widget for AI agent CLIs",
  "main": "electron/main.cjs",
  "private": true,
  "license": "MIT",
  "author": "Agent Widget",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE -u ELECTRON_NO_ATTACH_CONSOLE electron .",
    "launch": "zsh scripts/launch.sh",
    "install:app": "node scripts/install-wizard.cjs",
    "install:auto": "node scripts/install-wizard.cjs --auto",
    "uninstall:app": "node scripts/uninstall-wizard.cjs",
    "uninstall:auto": "node scripts/uninstall-wizard.cjs --auto",
    "screenshots": "env -u ELECTRON_RUN_AS_NODE -u ELECTRON_NO_ATTACH_CONSOLE electron scripts/capture-screenshots.cjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty && node scripts/ensure-electron.cjs",
    "ensure-electron": "node scripts/ensure-electron.cjs",
    "install-startup": "node scripts/install-startup.cjs",
    "uninstall-startup": "node scripts/uninstall-startup.cjs",
    "dist": "electron-builder --mac dmg --publish never",
    "dist:dir": "electron-builder --mac dir --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.agent-widget",
    "productName": "Agent Widget",
    "copyright": "Copyright © Agent Widget contributors",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "scripts/startup-lib.cjs",
      "package.json"
    ],
    "asarUnpack": [
      "**/node-pty/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/AppIcon.icns",
      "target": [
        "dmg"
      ],
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "LSMinimumSystemVersion": "13.0"
      }
    },
    "dmg": {
      "title": "Agent Widget",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
