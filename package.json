{
  "name": "agent-widget",
  "version": "1.0.0",
  "description": "Floating Mac desktop widget for AI agent CLIs",
  "main": "electron/main.cjs",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE -u ELECTRON_NO_ATTACH_CONSOLE electron .",
    "launch": "zsh scripts/launch.sh",
    "install:app": "node scripts/install-wizard.cjs",
    "install:auto": "node scripts/install-wizard.cjs --auto",
    "uninstall:app": "node scripts/uninstall-wizard.cjs",
    "uninstall:auto": "node scripts/uninstall-wizard.cjs --auto",
    "screenshots": "env -u ELECTRON_RUN_AS_NODE -u ELECTRON_NO_ATTACH_CONSOLE electron scripts/capture-screenshots.cjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty && node scripts/ensure-electron.cjs",
    "ensure-electron": "node scripts/ensure-electron.cjs",
    "install-startup": "node scripts/install-startup.cjs",
    "uninstall-startup": "node scripts/uninstall-startup.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "^37.2.0"
  }
}
